flowchart TB
    start["Unbound Pod at publication"] --> gated{"Scheduling gated?"}
    gated -->|Yes| preserveGate["Preserve gate ownership"]
    gated -->|No| outcome{"Final diagnostic outcome"}
    outcome -->|"Individual no-fit"| own["Own attributable failure"]
    outcome -->|"Gang waiting"| wait["Stable PodGroup reference"]
    outcome -->|"Retained placement"| retained["Live allocation or Pipeline explanation"]
    outcome -->|"Explicit blocker or error"| explicit["Actual restriction or error"]
    outcome -->|"Unknown or cache skip"| keep["No condition replacement"]
    own --> compare["Compare optional condition and nomination independently"]
    wait --> compare
    retained --> compare
    explicit --> compare
    keep --> compare
    compare --> changed{"Either needs updating?"}
    changed -->|Yes| publish["Existing Event and status publication"]
    changed -->|No| skip["Skip Pod Event and status write"]
    classDef decision fill:#ede9fe,stroke:#8b5cf6,color:#3b0764
    classDef output fill:#ecfdf5,stroke:#34d399,color:#064e3b
    classDef quiet fill:#f8fafc,stroke:#94a3b8,color:#334155
    class outcome,gated,changed decision
    class publish output
    class keep,skip,preserveGate quiet
